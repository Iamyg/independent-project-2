{
  "binary": [
    "c_custkey = o_custkey",
    "l_orderkey = o_orderkey"
  ],
  "aggregation": [
    "revenue"
  ],
  "unary": [
    {
      "lineitem": [
        "l_shipdate > DATE '1995-03-13'"
      ]
    },
    {
      "orders": [
        "o_orderdate < DATE '1995-03-13'"
      ]
    },
    {
      "customer": [
        "c_mktsegment = 'AUTOMOBILE'"
      ]
    }
  ],
  "relations": [
    "lineitem",
    "orders",
    "customer"
  ]
}